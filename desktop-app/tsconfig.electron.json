{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist-electron",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@scratchbox/core": [
        "../packages/core/src/index.ts"
      ],
      "@scratchbox/core/*": [
        "../packages/core/src/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "electron",
    "server"
  ]
}
