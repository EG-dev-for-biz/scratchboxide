{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "paths": {
      "@scratchbox/core": ["../packages/core/src/index.ts"],
      "@scratchbox/core/*": ["../packages/core/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "server", "electron", "test"]
}
