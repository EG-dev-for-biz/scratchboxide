{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "scratchbox-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SCRATCHBOX_NO_ELECTRON=true",
        "PORT=3013",
        "SCRATCHBOX_WEB_PORT=3032",
        "SCRATCHBOX_TOOLS_PORT=3014",
        "SCRATCHBOX_ALLOWED_ORIGINS=http://127.0.0.1:3032,http://localhost:3032",
        "npm",
        "run",
        "dev"
      ],
      "port": 3032
    },
    {
      "name": "scratchbox-remove-comfyui",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SCRATCHBOX_NO_ELECTRON=true",
        "PORT=3040",
        "SCRATCHBOX_WEB_PORT=3042",
        "SCRATCHBOX_TOOLS_PORT=3041",
        "SCRATCHBOX_ALLOWED_ORIGINS=http://127.0.0.1:3042,http://localhost:3042",
        "npm",
        "--prefix",
        "/Users/eligreen/dev/scratchbox-remove-comfyui",
        "run",
        "dev"
      ],
      "port": 3042,
      "autoPort": false
    },
    {
      "name": "serve-public",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SERVE_PUBLIC_SKIP_HYDRATE=1",
        "node",
        "scripts/serve_public.js",
        "5180"
      ],
      "port": 5180
    }
  ]
}