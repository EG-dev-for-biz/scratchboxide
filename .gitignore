.DS_Store
**/node_modules
**/.browser_modules
**/dist
**/lib
coverage/
**/src-gen
**/gen-webpack.config.js
**/gen-webpack.node.config.js
**/plugins
**/tsconfig.tsbuildinfo
*.log
license-check-summary.txt*

# Environment and sensitive production credentials
.env
*.env
.env.*
!.env.example
secrets.json
service-account.json
*.pem
*.key

# Local Scratchbox cache and artifacts
.scratchbox/
dist-electron/
models/
# Source code, not model files.
!packages/core/src/node/models/
# The MediaPipe pose model the pose tools load (Apache-2.0, 9.4 MB, from storage.googleapis.com/mediapipe-models),
# and the MediaPipe Interactive Segmenter (MagicTouch) model vfx_segment_subject loads for object masks
# (Apache-2.0, 6.2 MB, interactive_segmenter/magic_touch/float32/1/magic_touch.tflite, sha256 e24338a7...cd25).
!assets/models/
assets/models/*
!assets/models/pose_landmarker_full.task
!assets/models/magic_touch.tflite
build/
*.ckpt
*.safetensors

# Transient root artifacts and binary pipeline outputs
/ScratchboxIDE logo
/*.glb
/*.gltf
/*.ply
/*.splat
/*.o
/*.obj
/*.png
/*.jpg
/*.jpeg
/*.mp4

# Temporary experiment scratch directories
temp_*/
temp_unwrap_rewrap/
temp-artifacts/
**/temp-artifacts/
public/icons
.chrome-profile/
.tmp_chrome/
.tmp_chrome_vis/
scratch/
qc_debug.json
packages/.temp-cli-test-*/
# Media assets, 3D binary models (.glb, .gltf), and Gaussian Splats (.splat, .spz, .ply)
*.glb
*.gltf
*.splat
*.spz
*.ply
*.bin
*.fbx
*.mp4
*.webm
*.mov
*.depth.f32
*.rgb
*stations_to_fuse.txt

# Public media and runtime caches (keep HTML demos, JS scripts, JSON manifests, and SVGs tracked)
public/**/*.glb
public/**/*.gltf
public/**/*.splat
public/**/*.spz
public/**/*.ply
public/**/*.mp4
public/**/*.webm
public/**/*.mov
**/public/tiles/
# Test execution outputs, visual verification screenshots, and test artifacts
test-results/
**/test-results/
test-artifacts/
**/test-artifacts/
test-output/
**/test-output/
test/screenshots/
tests/screenshots/
**/screenshots/
public/screenshots/
docs/screenshots/
*.test.png
*_screenshot.png
*screenshot*.png
.vitest/

public/flight_frames/
public/visual_proof_locations/
public/visual_proof_real_tile/
public/comfyui_outputs/

# Explicit whitelist for demo source code and configurations
!public/**/*.html
!public/**/*.js
!public/**/*.css
!public/**/*.json
!public/**/*.svg
!public/demos/**
!manifests/**
# Built from scripts/walkable/walkable_3dgs_viewer.ts by scripts/walkable/build.sh
public/js/walkable_3dgs_viewer.js

data/s4d_dataset/
**/s4d_tile_blockout_runner*.html
**/build_py/
**/build_py.lock/
# Native Python engine modules are built on demand from packages/core/src/native/3d-engine; never commit them.
**/scratchbox_native*.so
**/scratchbox_native*.pyd
**/libscratchbox_core.dylib
**/libscratchbox_core.so
*.bak
__pycache__/
data/test_pilot_multiscene/

# Virtual environments
.venv/
venv/

# Compiled binaries of scripts/*.cpp
scripts/run_smpl_tree
scripts/station_to_splats
scripts/scratchbox_uv_pipeline
scripts/run_sb_veggie
scripts/run_tile_cleanup_pipeline
# Downloaded model weights (tools/depth/fetch_depth_model.py); never committed
/.model-cache/
