.DS_Store
**/node_modules
**/.browser_modules
**/dist
**/lib
coverage/
**/src-gen
**/gen-webpack.config.js
**/gen-webpack.node.config.js
**/plugins
**/tsconfig.tsbuildinfo
*.log
license-check-summary.txt*

# Environment and sensitive production credentials
.env
*.env
.env.*
!.env.example
secrets.json
service-account.json
*.pem
*.key

# Local Scratchbox cache and artifacts
.scratchbox/
dist-electron/
models/
