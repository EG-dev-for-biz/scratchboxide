{
  "name": "scratchbox-ide",
  "version": "1.0.0",
  "private": true,
  "description": "Scratchbox IDE — Generative Canvas Studio, Visual Primitives, 3D Geospatial Engine, and AI Workspace",
  "workspaces": [
    "packages/*",
    "desktop-app"
  ],
  "scripts": {
    "dev": "npm --prefix desktop-app run dev",
    "build": "npm --prefix packages/core run build && npm --prefix desktop-app run build",
    "build:core": "npm --prefix packages/core run build",
    "build:desktop": "npm --prefix desktop-app run build",
    "start": "npm --prefix desktop-app start",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p desktop-app && tsc --noEmit -p desktop-app/tsconfig.electron.json",
    "lint": "eslint packages/core/src desktop-app/src desktop-app/server desktop-app/electron --report-unused-disable-directives",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run packages/core/test",
    "test:desktop": "vitest run desktop-app/test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.9"
  }
}
