{
  "name": "scratchbox-ide",
  "version": "1.0.0",
  "private": true,
  "description": "Scratchbox IDE — Generative Canvas Studio, Visual Primitives, 3D Geospatial Engine, and AI Workspace",
  "license": "UNLICENSED",
  "author": "Scratchbox LLC",
  "workspaces": [
    "packages/*",
    "desktop-app"
  ],
  "scripts": {
    "hydrate": "node scripts/hydrate_demo_assets.cjs",
    "hydrate:check": "node scripts/hydrate_demo_assets.cjs --check",
    "predev": "node scripts/hydrate_demo_assets.cjs --quiet",
    "preserve": "node scripts/hydrate_demo_assets.cjs --quiet",
    "prestart": "node scripts/hydrate_demo_assets.cjs --quiet",
    "dev": "npm --prefix desktop-app run dev",
    "build": "npm --prefix packages/core run build && npm --prefix packages/cli run build && npm --prefix desktop-app run build",
    "build:core": "npm --prefix packages/core run build",
    "build:cli": "npm --prefix packages/cli run build",
    "build:desktop": "npm --prefix desktop-app run build",
    "sbox": "node packages/cli/bin/sbox.js",
    "serve": "node scripts/serve_public.js",
    "start": "npm --prefix desktop-app start",
    "proxy:vertex": "node scripts/vertex_proxy.mjs",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/cli && tsc --noEmit -p desktop-app && tsc --noEmit -p desktop-app/tsconfig.electron.json",
    "lint": "node scripts/lint_no_js_primitives.js && eslint packages/core/src desktop-app/src desktop-app/server desktop-app/electron --report-unused-disable-directives",
    "lint:primitives": "node scripts/lint_no_js_primitives.js",
    "audit:ast": "node .agents/skills/prevent-architectural-simulation-trap/scripts/audit_simulation_trap.js",
    "audit:math": "node .agents/skills/prevent-architectural-simulation-trap/scripts/verify_3d_math_invariants.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run packages/core/test",
    "test:cli": "vitest run packages/cli/test",
    "test:desktop": "vitest run desktop-app/test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "3d-tiles-rendererjs-3dgs-plugin": "^0.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gaussian-splat-lite": "^1.1.1",
    "globals": "^15.15.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0"
  }
}
