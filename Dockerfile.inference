# syntax=docker/dockerfile:1
# ------------------------------------------------------------------------------
# Scratchbox IDE & Neural Model Showcase - Inference Container
# Multi-runtime image supporting Node.js static/API serving, Python 3 inference,
# and native Clang C++20 toolchains.
# ------------------------------------------------------------------------------

# Compile the packages/core services serve_public.cjs calls (npm run build:serve-public) to CommonJS. The lighting
# service (PhotometricUsdBridgeService) needs three and jpeg-js at runtime; they are installed beside the output at
# the versions package-lock.json pins for packages/core.
FROM node:22-bookworm-slim AS serve-public-core
WORKDIR /build
RUN npm install --no-save --no-package-lock typescript@5.9.3
COPY package.json ./
COPY packages/core/src ./packages/core/src
RUN npm run build:serve-public \
    && npm install --no-save --no-package-lock --omit=dev --prefix build/serve-public-core three@0.186.0 jpeg-js@0.4.4

FROM node:22-bookworm-slim

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV PORT=8080
# Listen on all interfaces so the published container port is reachable. Requests are still admitted only with a
# loopback Host header on this port (e.g. the HEALTHCHECK below) or one listed in SERVE_PUBLIC_ALLOWED_HOSTS, and
# cross-origin API calls only from SERVE_PUBLIC_ALLOWED_ORIGINS: set those to the deployed hostname / origin.
ENV SERVE_PUBLIC_HOST=0.0.0.0
ENV PYTHON_BIN=python3

# Install system dependencies: Python 3, pip, Clang C++20 compiler, FFmpeg
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    clang \
    build-essential \
    ffmpeg \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies for the GeoBox geolocation model & DepthBox pipelines
RUN pip3 install --no-cache-dir --break-system-packages \
    torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip3 install --no-cache-dir --break-system-packages \
    pillow \
    numpy \
    scipy \
    opencv-python-headless \
    requests

# Copy package descriptors first for caching
COPY package.json package-lock.json* ./

# Install Node dependencies (production only if available)
RUN npm install --omit=dev --ignore-scripts || npm install --omit=dev

# Copy application directories
COPY public ./public
COPY scripts ./scripts
COPY tools ./tools
COPY packages ./packages

# serve_public.cjs runs the TypeScript GeoBox resection, 3D Tiles and photometric lighting / OpenUSD services from
# packages/core, compiled to CommonJS for plain Node in the serve-public-core stage above.
COPY --from=serve-public-core /build/build/serve-public-core ./build/serve-public-core

# Expose Google Cloud Run standard port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/api/geobox/health || exit 1

# Start server
CMD ["node", "scripts/serve_public.cjs"]
