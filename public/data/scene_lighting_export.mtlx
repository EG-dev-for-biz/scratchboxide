<?xml version="1.0"?>
<materialx version="1.38">
  <!-- MaterialX Physical Shader calibrated to Real-World Reference -->
  <standard_surface name="CalibratedStone_surface" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" value="0.860, 0.820, 0.780" />
    <input name="diffuse_roughness" type="float" value="0.820" />
    <input name="specular" type="float" value="0.25" />
    <input name="specular_roughness" type="float" value="0.820" />
    <input name="specular_IOR" type="float" value="1.54" />
  </standard_surface>

  <surfacematerial name="CalibratedStone" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="CalibratedStone_surface" />
  </surfacematerial>
</materialx>
