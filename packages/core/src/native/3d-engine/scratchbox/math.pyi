"""High-performance vector and spatial math"""

from collections.abc import Iterator
from typing import overload


class Vec2:
    @overload
    def __init__(self) -> None: ...

    @overload
    def __init__(self, x: float, y: float) -> None: ...

    @overload
    def __init__(self, arg: tuple[float, float], /) -> None: ...

    @property
    def x(self) -> float: ...

    @x.setter
    def x(self, arg: float, /) -> None: ...

    @property
    def y(self) -> float: ...

    @y.setter
    def y(self, arg: float, /) -> None: ...

    def __len__(self) -> int: ...

    def __getitem__(self, arg: int, /) -> float: ...

    def __setitem__(self, arg0: int, arg1: float, /) -> None: ...

    def __iter__(self) -> Iterator: ...

    def __neg__(self) -> Vec2: ...

    def __eq__(self, arg: Vec2, /) -> bool: ...

    def __repr__(self) -> str: ...

class Vec3:
    @overload
    def __init__(self) -> None: ...

    @overload
    def __init__(self, x: float, y: float, z: float) -> None: ...

    @overload
    def __init__(self, arg: tuple[float, float, float], /) -> None: ...

    @property
    def x(self) -> float: ...

    @x.setter
    def x(self, arg: float, /) -> None: ...

    @property
    def y(self) -> float: ...

    @y.setter
    def y(self, arg: float, /) -> None: ...

    @property
    def z(self) -> float: ...

    @z.setter
    def z(self, arg: float, /) -> None: ...

    def length(self) -> float: ...

    def normalized(self) -> Vec3: ...

    def dot(self, arg: Vec3, /) -> float: ...

    def cross(self, arg: Vec3, /) -> Vec3: ...

    def __len__(self) -> int: ...

    def __getitem__(self, arg: int, /) -> float: ...

    def __setitem__(self, arg0: int, arg1: float, /) -> None: ...

    def __iter__(self) -> Iterator: ...

    def __neg__(self) -> Vec3: ...

    def __eq__(self, arg: Vec3, /) -> bool: ...

    def __add__(self, arg: Vec3, /) -> Vec3: ...

    def __sub__(self, arg: Vec3, /) -> Vec3: ...

    @overload
    def __mul__(self, arg: float, /) -> Vec3: ...

    @overload
    def __mul__(self, arg: Vec3, /) -> Vec3: ...

    def __rmul__(self, arg: float, /) -> Vec3: ...

    def __truediv__(self, arg: float, /) -> Vec3: ...

    def __repr__(self) -> str: ...

class Vec4:
    @overload
    def __init__(self) -> None: ...

    @overload
    def __init__(self, x: float, y: float, z: float, w: float) -> None: ...

    @overload
    def __init__(self, arg: tuple[float, float, float, float], /) -> None: ...

    @property
    def x(self) -> float: ...

    @x.setter
    def x(self, arg: float, /) -> None: ...

    @property
    def y(self) -> float: ...

    @y.setter
    def y(self, arg: float, /) -> None: ...

    @property
    def z(self) -> float: ...

    @z.setter
    def z(self, arg: float, /) -> None: ...

    @property
    def w(self) -> float: ...

    @w.setter
    def w(self, arg: float, /) -> None: ...

    def __len__(self) -> int: ...

    def __getitem__(self, arg: int, /) -> float: ...

    def __setitem__(self, arg0: int, arg1: float, /) -> None: ...

    def __iter__(self) -> Iterator: ...

    def __neg__(self) -> Vec4: ...

    def __eq__(self, arg: Vec4, /) -> bool: ...

    def __repr__(self) -> str: ...

class Quat:
    @overload
    def __init__(self) -> None: ...

    @overload
    def __init__(self, x: float, y: float, z: float, w: float) -> None: ...

    @property
    def x(self) -> float: ...

    @x.setter
    def x(self, arg: float, /) -> None: ...

    @property
    def y(self) -> float: ...

    @y.setter
    def y(self, arg: float, /) -> None: ...

    @property
    def z(self) -> float: ...

    @z.setter
    def z(self, arg: float, /) -> None: ...

    @property
    def w(self) -> float: ...

    @w.setter
    def w(self, arg: float, /) -> None: ...

    def __len__(self) -> int: ...

    def __getitem__(self, arg: int, /) -> float: ...

    def __iter__(self) -> Iterator: ...

    def __neg__(self) -> Quat: ...

    @staticmethod
    def from_axis_angle(axis: Vec3, angle_radians: float) -> Quat: ...

    def rotate(self, vec: Vec3) -> Vec3: ...

    def __repr__(self) -> str: ...

class AABB:
    @overload
    def __init__(self) -> None: ...

    @overload
    def __init__(self, min: Vec3, max: Vec3) -> None: ...

    @property
    def min(self) -> Vec3: ...

    @min.setter
    def min(self, arg: Vec3, /) -> None: ...

    @property
    def max(self) -> Vec3: ...

    @max.setter
    def max(self, arg: Vec3, /) -> None: ...

    @property
    def center(self) -> Vec3: ...

    @property
    def size(self) -> Vec3: ...

    @property
    def surface_area(self) -> float: ...

    def contains(self, p: Vec3) -> bool: ...

    def intersects(self, other: AABB) -> bool: ...

    def expand(self, p: Vec3) -> None: ...

    def expand_box(self, other: AABB) -> None: ...

    def __repr__(self) -> str: ...
