"""Mesh topology, primitives and PBR materials"""

from collections.abc import Sequence
from typing import overload

import scratchbox_native.math
import scratchbox_native.processing


class Vertex:
    @overload
    def __init__(self) -> None: ...

    @overload
    def __init__(self, position: scratchbox_native.math.Vec3, normal: scratchbox_native.math.Vec3 = ..., uv: scratchbox_native.math.Vec2 = ..., color: scratchbox_native.math.Vec4 = ..., tangent: scratchbox_native.math.Vec4 = ...) -> None: ...

    @property
    def position(self) -> scratchbox_native.math.Vec3: ...

    @position.setter
    def position(self, arg: scratchbox_native.math.Vec3, /) -> None: ...

    @property
    def normal(self) -> scratchbox_native.math.Vec3: ...

    @normal.setter
    def normal(self, arg: scratchbox_native.math.Vec3, /) -> None: ...

    @property
    def uv(self) -> scratchbox_native.math.Vec2: ...

    @uv.setter
    def uv(self, arg: scratchbox_native.math.Vec2, /) -> None: ...

    @property
    def color(self) -> scratchbox_native.math.Vec4: ...

    @color.setter
    def color(self, arg: scratchbox_native.math.Vec4, /) -> None: ...

    @property
    def tangent(self) -> scratchbox_native.math.Vec4: ...

    @tangent.setter
    def tangent(self, arg: scratchbox_native.math.Vec4, /) -> None: ...

class PbrMaterial:
    @overload
    def __init__(self, name: str = 'defaultMaterial') -> None: ...

    @overload
    def __init__(self, name: str = 'defaultMaterial', base_color: scratchbox_native.math.Vec4 | None = None, color: scratchbox_native.math.Vec4 | None = None, metallic: float | None = None, metalness: float | None = None, roughness: float | None = None, emissive: object | None = None, emissive_intensity: float | None = None, clearcoat: float | None = None, ior: float | None = None) -> None: ...

    @property
    def name(self) -> str: ...

    @name.setter
    def name(self, arg: str, /) -> None: ...

    @property
    def base_color(self) -> scratchbox_native.math.Vec4: ...

    @base_color.setter
    def base_color(self, arg: scratchbox_native.math.Vec4, /) -> None: ...

    @property
    def color(self) -> scratchbox_native.math.Vec4: ...

    @color.setter
    def color(self, arg: scratchbox_native.math.Vec4, /) -> None: ...

    @property
    def metallic(self) -> float: ...

    @metallic.setter
    def metallic(self, arg: float, /) -> None: ...

    @property
    def metalness(self) -> float: ...

    @metalness.setter
    def metalness(self, arg: float, /) -> None: ...

    @property
    def roughness(self) -> float: ...

    @roughness.setter
    def roughness(self, arg: float, /) -> None: ...

    @property
    def emissive(self) -> scratchbox_native.math.Vec3: ...

    @emissive.setter
    def emissive(self, arg: scratchbox_native.math.Vec3, /) -> None: ...

    @property
    def emissive_intensity(self) -> float: ...

    @emissive_intensity.setter
    def emissive_intensity(self, arg: float, /) -> None: ...

    @property
    def clearcoat(self) -> float: ...

    @clearcoat.setter
    def clearcoat(self, arg: float, /) -> None: ...

    @property
    def ior(self) -> float: ...

    @ior.setter
    def ior(self, arg: float, /) -> None: ...

    def set_base_color(self, color: scratchbox_native.math.Vec4) -> None: ...

    def set_color(self, color: scratchbox_native.math.Vec4) -> None: ...

    @staticmethod
    def titanium() -> PbrMaterial: ...

    @staticmethod
    def chrome() -> PbrMaterial: ...

    @staticmethod
    def gold() -> PbrMaterial: ...

    @staticmethod
    def basalt_rock() -> PbrMaterial: ...

    @staticmethod
    def wood_oak() -> PbrMaterial: ...

    @staticmethod
    def rough_wood() -> PbrMaterial: ...

    @staticmethod
    def optical_glass() -> PbrMaterial: ...

    @staticmethod
    def stone_limestone() -> PbrMaterial: ...

    @staticmethod
    def concrete_brutalist() -> PbrMaterial: ...

    @staticmethod
    def asphalt_street() -> PbrMaterial: ...

    @staticmethod
    def quartz_crystal() -> PbrMaterial: ...

    @staticmethod
    def carbon_composite() -> PbrMaterial: ...

    @staticmethod
    def polished_brass() -> PbrMaterial: ...

    @staticmethod
    def copper_bullet() -> PbrMaterial: ...

    @staticmethod
    def metal_dark_anodized() -> PbrMaterial: ...

    @staticmethod
    def metal_brushed_steel() -> PbrMaterial: ...

    @staticmethod
    def plastic_smooth_black() -> PbrMaterial: ...

    @staticmethod
    def plastic_shiny(color: scratchbox_native.math.Vec4 = ...) -> PbrMaterial: ...

    @staticmethod
    def glass_tinted(color: scratchbox_native.math.Vec4 = ..., roughness: float = 0.07999999821186066, ior: float = 1.5199999809265137) -> PbrMaterial: ...

    @staticmethod
    def stone_rough(color: scratchbox_native.math.Vec4 = ...) -> PbrMaterial: ...

    @staticmethod
    def obsidian() -> PbrMaterial: ...

    @staticmethod
    def emissive_glow(color: scratchbox_native.math.Vec3, intensity: float = 1.0) -> PbrMaterial: ...

class Mesh:
    @overload
    def __init__(self) -> None: ...

    @overload
    def __init__(self, name: str = 'mesh') -> None: ...

    @property
    def name(self) -> str: ...

    @name.setter
    def name(self, arg: str, /) -> None: ...

    @property
    def material(self) -> PbrMaterial: ...

    @material.setter
    def material(self, arg: PbrMaterial, /) -> None: ...

    @property
    def vertex_count(self) -> int: ...

    @property
    def triangle_count(self) -> int: ...

    @property
    def bounds(self) -> scratchbox_native.math.AABB: ...

    @property
    def vertices(self) -> list[Vertex]: ...

    @property
    def indices(self) -> list[int]: ...

    def get_positions_flat(self) -> bytes: ...

    def get_normals_flat(self) -> bytes: ...

    def get_indices_bytes(self) -> bytes: ...

    def add_vertex(self, pos: scratchbox_native.math.Vec3, norm: scratchbox_native.math.Vec3 = ..., uv: scratchbox_native.math.Vec2 = ..., color: scratchbox_native.math.Vec4 = ...) -> None: ...

    def add_triangle(self, i0: int, i1: int, i2: int) -> None: ...

    def append(self, other: Mesh) -> Mesh:
        """Merge another mesh into this container"""

    def translate(self, offset: scratchbox_native.math.Vec3) -> Mesh: ...

    def scale(self, factors: scratchbox_native.math.Vec3) -> Mesh: ...

    def rotate_x(self, angle_deg: float) -> Mesh: ...

    def rotate_y(self, angle_deg: float) -> Mesh: ...

    def rotate_z(self, angle_deg: float) -> Mesh: ...

    def set_color(self, color: scratchbox_native.math.Vec4) -> Mesh: ...

    def set_material(self, material: PbrMaterial) -> Mesh: ...

    def apply_material(self, material: PbrMaterial) -> Mesh: ...

    def compute_curvature_ao(self, intensity: float = 0.6000000238418579) -> Mesh: ...

    def apply_procedural_weathering(self, frequency: float = 2.0, amplitude: float = 0.15000000596046448) -> Mesh: ...

    def displace_along_normals(self, frequency: float = 2.0, amplitude: float = 0.05000000074505806) -> Mesh: ...

    def tessellate_and_displace(self, tessellation_factor: int = 4, displacement_scale: float = 0.05999999865889549, noise_freq: float = 32.0, noise_amp: float = 0.014999999664723873) -> Mesh: ...

    def clear(self) -> None: ...

    def recompute_normals(self) -> Mesh: ...

    def recompute_smooth_normals(self) -> Mesh: ...

    def weld_vertices(self, epsilon: float = 9.999999747378752e-05) -> Mesh: ...

    def recompute_bounds(self) -> Mesh: ...

    def subdivide(self, iterations: int = 1) -> Mesh: ...

    def taper(self, axis: int = 1, factor: float = 0.5) -> Mesh: ...

    def twist(self, axis: int = 1, angle_deg: float = 45.0) -> Mesh: ...

    def bend(self, main_axis: int = 1, bend_axis: int = 0, angle_deg: float = 30.0, radius: float = 2.0) -> Mesh: ...

    def bulge(self, center: scratchbox_native.math.Vec3 = ..., radius: float = 1.0, strength: float = 0.30000001192092896, power: float = 2.0) -> Mesh: ...

    def taubin_smooth(self, iterations: int = 10, lambda_val: float = 0.5, mu_val: float = -0.5299999713897705, preserve_boundaries: bool = True) -> Mesh: ...
    def tag(self, tag_name: str) -> Mesh: ...
    def get_tag(self) -> str: ...

    def clean(self, weld_epsilon: float = 9.999999747378752e-06) -> Mesh: ...

    def bake_cavity_ao(self, intensity: float = 0.6499999761581421) -> Mesh: ...

    def slice_by_plane(self, plane_point: scratchbox_native.math.Vec3 = ..., plane_normal: scratchbox_native.math.Vec3 = ..., keep_positive: bool = True, cap_cut: bool = True) -> Mesh: ...

    def isotropic_remesh(self, target_edge_length: float = 0.25, iterations: int = 4, crease_angle_deg: float = 45.0) -> Mesh: ...

    def decimate_qem(self, target_triangles: int = 0, target_ratio: float = 0.5, max_error: float = 1000000000.0, preserve_boundary: bool = True) -> Mesh: ...

    def decimate(self, ratio: float = 0.5, target_triangles: int = 0) -> Mesh: ...

    def poisson_sample(self, count: int = 100, min_distance: float = 0.0, seed: int = 42) -> list[scratchbox_native.processing.SurfaceSamplePoint]: ...

    def fill_holes(self, max_hole_edges: int = 64) -> Mesh: ...

    def hausdorff_distance(self, other: Mesh, samples: int = 500) -> scratchbox_native.processing.HausdorffResult: ...

    def __repr__(self) -> str: ...

def create_plane(width: float = 2.0, height: float = 2.0, seg_x: int = 4, seg_y: int = 4) -> Mesh: ...

def create_sphere(radius: float = 1.0, rings: int = 16, sectors: int = 32, color: scratchbox_native.math.Vec4 = ...) -> Mesh: ...

def create_box(size: scratchbox_native.math.Vec3 = ..., color: scratchbox_native.math.Vec4 = ...) -> Mesh: ...

def create_cylinder(radius_top: float = 1.0, radius_bottom: float = 1.0, height: float = 2.0, segments: int = 24, color: scratchbox_native.math.Vec4 = ...) -> Mesh: ...

def create_torus(main_radius: float = 1.0, tube_radius: float = 0.25, radial_segments: int = 24, tubular_segments: int = 36, color: scratchbox_native.math.Vec4 = ...) -> Mesh: ...

def create_studio_pedestal(radius: float = 4.0, height: float = 0.25, bevel_radius: float = 0.03999999910593033, segments: int = 64) -> Mesh: ...

def create_fluted_column(radius: float = 0.44999998807907104, height: float = 7.0, flutes: int = 16, segments: int = 48, color: scratchbox_native.math.Vec4 = ...) -> Mesh: ...

def create_beveled_box(size: scratchbox_native.math.Vec3 = ..., bevel_radius: float = 0.019999999552965164, color: scratchbox_native.math.Vec4 = ...) -> Mesh: ...

def create_subdivided_box(size: scratchbox_native.math.Vec3 = ..., sub_x: int = 4, sub_y: int = 4, sub_z: int = 4, color: scratchbox_native.math.Vec4 = ...) -> Mesh: ...

def create_envelope(bounds: scratchbox_native.math.Vec3 = ..., crown: float = 0.25, slope: float = 0.30000001192092896, center_dip: float = 0.0, grid_x: int = 16, grid_z: int = 16, color: scratchbox_native.math.Vec4 = ...) -> Mesh: ...

def create_arched_blister(bounds: scratchbox_native.math.Vec3 = ..., arch_radius: float = 0.4000000059604645, swell: float = 0.07999999821186066, grid_phi: int = 16, grid_w: int = 8, side_sign: float = 1.0, color: scratchbox_native.math.Vec4 = ...) -> Mesh: ...

def create_lathe(profile: Sequence[scratchbox_native.math.Vec2], radial_segments: int = 32, total_angle_rad: float = 6.2831854820251465, color: scratchbox_native.math.Vec4 = ...) -> Mesh: ...

def create_loft(slices: Sequence[Sequence[scratchbox_native.math.Vec3]], close_ends: bool = True, color: scratchbox_native.math.Vec4 = ...) -> Mesh: ...

def create_revolving_component(radius: float = 0.5, length: float = 1.0, axis: Union[str, Tuple[float, float, float]] = "lateral", profile: str = "cylinder", crown: float = 0.0, recess: float = 0.0, segments: int = 32, color: Any = ..., material: Any = ..., **kwargs: Any) -> Mesh: ...

def create_wheel(radius: float = 0.35, width: float = 0.30, rim_radius: Optional[float] = None, rim_recess: float = 0.04, tread_bevel: float = 0.025, axis: str = "lateral", ground: bool = True, color: Any = ..., material: Any = ..., **kwargs: Any) -> Mesh: ...

def create_wheel_assembly(track_width: float = 1.6, wheelbase: float = 3.2, wheel_radius: float = 0.35, tire_width: float = 0.30, ground_clearance: float = 0.05, axle_pairs: int = 2, camber_deg: float = 0.0, toe_deg: float = 0.0, suspension: str = "double_wishbone", color: Any = ..., material: Any = ..., **kwargs: Any) -> Mesh: ...

def create_lofted_hull(stations: Sequence[Any], profile: str = "superellipse", m: float = 2.8, close_ends: bool = True, n_pts: int = 32, color: Any = ..., material: Any = ..., **kwargs: Any) -> Mesh: ...

def create_cambered_foil(span: float = 1.8, chord: float = 0.45, camber: float = 0.04, thickness: float = 0.05, angle_of_attack_deg: float = -4.0, axis: str = "x", endplates: bool = True, endplate_height: float = 0.25, endplate_thickness: float = 0.015, color: Any = ..., material: Any = ..., **kwargs: Any) -> Mesh: ...

def validate_scene(scene_or_mesh: Any, auto_heal: bool = True) -> Dict[str, Any]: ...

