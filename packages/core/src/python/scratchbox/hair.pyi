"""
Analytical forward hair grooming, Marschner reflectance, and Gaussian splat synthesis
"""

from collections.abc import Sequence

import scratchbox_native.geometry
import scratchbox_native.math


class GaussianSplat:
    def __init__(self) -> None: ...

    @property
    def position(self) -> scratchbox_native.math.Vec3: ...

    @position.setter
    def position(self, arg: scratchbox_native.math.Vec3, /) -> None: ...

    @property
    def scale(self) -> scratchbox_native.math.Vec3: ...

    @scale.setter
    def scale(self, arg: scratchbox_native.math.Vec3, /) -> None: ...

    @property
    def rotation(self) -> scratchbox_native.math.Quat: ...

    @rotation.setter
    def rotation(self, arg: scratchbox_native.math.Quat, /) -> None: ...

    @property
    def color(self) -> scratchbox_native.math.Vec3: ...

    @color.setter
    def color(self, arg: scratchbox_native.math.Vec3, /) -> None: ...

    @property
    def opacity(self) -> float: ...

    @opacity.setter
    def opacity(self, arg: float, /) -> None: ...

    @property
    def sh(self) -> list[float]: ...

    @sh.setter
    def sh(self, arg: Sequence[float], /) -> None: ...

class HairGroomConfig:
    def __init__(self) -> None: ...

    @property
    def guide_count(self) -> int: ...

    @guide_count.setter
    def guide_count(self, arg: int, /) -> None: ...

    @property
    def strand_count(self) -> int: ...

    @strand_count.setter
    def strand_count(self, arg: int, /) -> None: ...

    @property
    def segments_per_strand(self) -> int: ...

    @segments_per_strand.setter
    def segments_per_strand(self, arg: int, /) -> None: ...

    @property
    def length(self) -> float: ...

    @length.setter
    def length(self, arg: float, /) -> None: ...

    @property
    def root_width(self) -> float: ...

    @root_width.setter
    def root_width(self, arg: float, /) -> None: ...

    @property
    def tip_width(self) -> float: ...

    @tip_width.setter
    def tip_width(self, arg: float, /) -> None: ...

    @property
    def clumping(self) -> float: ...

    @clumping.setter
    def clumping(self, arg: float, /) -> None: ...

    @property
    def curl_radius(self) -> float: ...

    @curl_radius.setter
    def curl_radius(self, arg: float, /) -> None: ...

    @property
    def curl_frequency(self) -> float: ...

    @curl_frequency.setter
    def curl_frequency(self, arg: float, /) -> None: ...

    @property
    def wave_frequency(self) -> float: ...

    @wave_frequency.setter
    def wave_frequency(self, arg: float, /) -> None: ...

    @property
    def wave_amplitude(self) -> float: ...

    @wave_amplitude.setter
    def wave_amplitude(self, arg: float, /) -> None: ...

    @property
    def eumelanin(self) -> float: ...

    @eumelanin.setter
    def eumelanin(self, arg: float, /) -> None: ...

    @property
    def pheomelanin(self) -> float: ...

    @pheomelanin.setter
    def pheomelanin(self, arg: float, /) -> None: ...

    @property
    def cuticle_tilt(self) -> float: ...

    @cuticle_tilt.setter
    def cuticle_tilt(self, arg: float, /) -> None: ...

    @property
    def longitudinal_roughness(self) -> float: ...

    @longitudinal_roughness.setter
    def longitudinal_roughness(self, arg: float, /) -> None: ...

    @property
    def azimuthal_roughness(self) -> float: ...

    @azimuthal_roughness.setter
    def azimuthal_roughness(self, arg: float, /) -> None: ...

class HairGuide:
    def __init__(self) -> None: ...

    @property
    def root(self) -> scratchbox_native.math.Vec3: ...

    @root.setter
    def root(self, arg: scratchbox_native.math.Vec3, /) -> None: ...

    @property
    def p1(self) -> scratchbox_native.math.Vec3: ...

    @p1.setter
    def p1(self, arg: scratchbox_native.math.Vec3, /) -> None: ...

    @property
    def p2(self) -> scratchbox_native.math.Vec3: ...

    @p2.setter
    def p2(self, arg: scratchbox_native.math.Vec3, /) -> None: ...

    @property
    def tip(self) -> scratchbox_native.math.Vec3: ...

    @tip.setter
    def tip(self, arg: scratchbox_native.math.Vec3, /) -> None: ...

    @property
    def length(self) -> float: ...

    @length.setter
    def length(self, arg: float, /) -> None: ...

    def evaluate(self, t: float) -> scratchbox_native.math.Vec3: ...

    def evaluate_tangent(self, t: float) -> scratchbox_native.math.Vec3: ...

class HairStrand:
    def __init__(self) -> None: ...

    @property
    def guide_index(self) -> int: ...

    @guide_index.setter
    def guide_index(self, arg: int, /) -> None: ...

    @property
    def curl_phase(self) -> float: ...

    @curl_phase.setter
    def curl_phase(self, arg: float, /) -> None: ...

    @property
    def base_color(self) -> scratchbox_native.math.Vec3: ...

    @base_color.setter
    def base_color(self, arg: scratchbox_native.math.Vec3, /) -> None: ...

    @property
    def vertex_count(self) -> int: ...

def generate_scalp_guides(scalp_center: scratchbox_native.math.Vec3, scalp_radius: float, config: HairGroomConfig, flow_direction: scratchbox_native.math.Vec3 = ...) -> list[HairGuide]: ...

def generate_surface_guides(surface_positions: Sequence[scratchbox_native.math.Vec3], surface_normals: Sequence[scratchbox_native.math.Vec3], config: HairGroomConfig, flow_direction: scratchbox_native.math.Vec3 = ...) -> list[HairGuide]: ...

def generate_harmonic_guides(center: scratchbox_native.math.Vec3, base_radius: float, harmonic_frequency: int, harmonic_amplitude: float, config: HairGroomConfig, axial_taper: float = 0.0) -> list[HairGuide]: ...

def synthesize_dense_strands(guides: Sequence[HairGuide], config: HairGroomConfig) -> list[HairStrand]: ...

def build_ribbon_mesh(strands: Sequence[HairStrand], camera_pos: scratchbox_native.math.Vec3 = ..., mesh_name: str = 'hair_ribbons') -> scratchbox_native.geometry.Mesh: ...

def build_strand_splats(strands: Sequence[HairStrand], splat_scale_multiplier: float = 1.0, base_opacity: float = 0.9200000166893005, custom_base_color: scratchbox_native.math.Vec3 = ..., custom_tip_color: scratchbox_native.math.Vec3 = ...) -> list[GaussianSplat]: ...

def build_surfel_mesh(splats: Sequence[GaussianSplat], radius_multiplier: float = 1.25, min_opacity_threshold: float = 0.05000000074505806) -> scratchbox_native.geometry.Mesh: ...

def build_spz(strands: Sequence[HairStrand], splat_scale_multiplier: float = 1.0, base_opacity: float = 0.9200000166893005) -> bytes: ...

def save_spz_file(filepath: str, splats: Sequence[GaussianSplat]) -> bool: ...

def save_ply_file(filepath: str, splats: Sequence[GaussianSplat]) -> bool: ...
