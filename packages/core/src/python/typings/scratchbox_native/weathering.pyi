    def __init__(self) -> None: ...

    @property
    def size_px(self) -> int: ...
    @size_px.setter
    def size_px(self, value: int) -> None: ...

    @property
    def color(self) -> scratchbox_native.math.Vec3: ...
    @color.setter
    def color(self, value: scratchbox_native.math.Vec3) -> None: ...

    @property
    def opacity(self) -> float: ...
    @opacity.setter
    def opacity(self, value: float) -> None: ...

    @property
    def edge_noise(self) -> float: ...
    @edge_noise.setter
    def edge_noise(self, value: float) -> None: ...

    @property
    def softness(self) -> float: ...
    @softness.setter
    def softness(self, value: float) -> None: ...

    @property
    def mottling(self) -> float: ...
    @mottling.setter
    def mottling(self, value: float) -> None: ...

    @property
    def drips(self) -> float: ...
    @drips.setter
    def drips(self, value: float) -> None: ...

    @property
    def drip_length(self) -> float: ...
    @drip_length.setter
