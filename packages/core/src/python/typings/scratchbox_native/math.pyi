"""High-performance vector and spatial math"""

import collections.abc
import typing

__all__ = ['AABB', 'Quat', 'Vec2', 'Vec3', 'Vec4']


class AABB:
    @typing.overload
    def __init__(self) -> None: ...

    @typing.overload
    def __init__(self, min: scratchbox_native.math.Vec3, max: scratchbox_native.math.Vec3) -> None: ...

    @property
    def min(self) -> Vec3: ...
    @min.setter
    def min(self, value: Vec3) -> None: ...

    @property
    def max(self) -> Vec3: ...
    @max.setter
    def max(self, value: Vec3) -> None: ...

    @property
    def center(self) -> Vec3: ...

    @property
    def size(self) -> Vec3: ...

    @property
    def surface_area(self) -> float: ...

    def contains(self, p: scratchbox_native.math.Vec3) -> bool: ...

    def intersects(self, other: scratchbox_native.math.AABB) -> bool: ...

    def expand(self, p: scratchbox_native.math.Vec3) -> None: ...

    def expand_box(self, other: scratchbox_native.math.AABB) -> None: ...

    def __repr__(self) -> str: ...


class Quat:
    @typing.overload
    def __init__(self) -> None: ...

    @typing.overload
    def __init__(self, x: float, y: float, z: float, w: float) -> None: ...

    @property
    def x(self) -> float: ...
    @x.setter
    def x(self, value: float) -> None: ...

    @property
    def y(self) -> float: ...
    @y.setter
    def y(self, value: float) -> None: ...

    @property
    def z(self) -> float: ...
    @z.setter
    def z(self, value: float) -> None: ...

    @property
    def w(self) -> float: ...
    @w.setter
    def w(self, value: float) -> None: ...

    def __len__(self) -> int: ...

    def __getitem__(self, arg: int, /) -> float: ...

    def __iter__(self) -> collections.abc.Iterator: ...

    def __neg__(self) -> Quat: ...

    @staticmethod
    def from_axis_angle(axis: scratchbox_native.math.Vec3, angle_radians: float) -> Quat: ...

    def rotate(self, vec: scratchbox_native.math.Vec3) -> Vec3: ...

    def __repr__(self) -> str: ...


