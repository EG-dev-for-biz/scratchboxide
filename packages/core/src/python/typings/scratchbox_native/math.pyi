    @z.setter
    def z(self, value: float) -> None: ...

    def length(self) -> float: ...

    def normalized(self) -> Vec3: ...

    def dot(self, arg: scratchbox_native.math.Vec3, /) -> float: ...

    def cross(self, arg: scratchbox_native.math.Vec3, /) -> Vec3: ...

    def __len__(self) -> int: ...

    def __getitem__(self, arg: int, /) -> float: ...

    def __setitem__(self, arg0: int, arg1: float, /) -> None: ...

    def __iter__(self) -> collections.abc.Iterator: ...

    def __neg__(self) -> Vec3: ...

    def __eq__(self, arg: scratchbox_native.math.Vec3, /) -> bool: ...

    def __add__(self, arg: scratchbox_native.math.Vec3, /) -> Vec3: ...

    def __sub__(self, arg: scratchbox_native.math.Vec3, /) -> Vec3: ...

    @typing.overload
    def __mul__(self, arg: float, /) -> Vec3: ...

    @typing.overload
