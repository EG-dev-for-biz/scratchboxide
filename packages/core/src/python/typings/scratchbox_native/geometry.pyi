__all__ = ['Mesh', 'PbrMaterial', 'Vertex', 'create_arched_blister', 'create_beveled_box', 'create_box', 'create_cambered_foil', 'create_catenary_cable', 'create_cone', 'create_cube', 'create_cylinder', 'create_envelope', 'create_fluted_column', 'create_form', 'create_lathe', 'create_loft', 'create_lofted_hull', 'create_plane', 'create_revolving_component', 'create_sphere', 'create_studio_pedestal', 'create_subdivided_box', 'create_torus', 'create_wheel', 'create_wheel_assembly']


class Mesh:
    @typing.overload
    def __init__(self) -> None: ...

    @typing.overload
    def __init__(self, name: str = 'mesh') -> None: ...

    @property
    def name(self) -> str: ...
    @name.setter
    def name(self, value: str) -> None: ...

    @property
    def material(self) -> PbrMaterial: ...
    @material.setter
    def material(self, value: PbrMaterial) -> None: ...

    @property
    def vertex_count(self) -> int: ...

    @property
    def triangle_count(self) -> int: ...

    @property
    def bounds(self) -> scratchbox_native.math.AABB: ...

    @property
    def vertices(self) -> list[Vertex]: ...

    @property
    def indices(self) -> list[int]: ...

    def get_positions_flat(self) -> bytes: ...

    def get_normals_flat(self) -> bytes: ...

    def get_indices_bytes(self) -> bytes: ...

    def add_vertex(self, pos: scratchbox_native.math.Vec3, norm: scratchbox_native.math.Vec3 = ..., uv: scratchbox_native.math.Vec2 = ..., color: scratchbox_native.math.Vec4 = ...) -> None: ...

    def add_triangle(self, i0: int, i1: int, i2: int) -> None: ...

    def append(self, other) -> Mesh:
        """Merge another mesh into this container"""

    def translate(self, *args) -> Mesh: ...

    def scale(self, *args) -> Mesh: ...

    def rotate_x(self, angle_deg) -> Mesh: ...

    def rotate_y(self, angle_deg) -> Mesh: ...

    def rotate_z(self, angle_deg) -> Mesh: ...

    def set_color(self, color: scratchbox_native.math.Vec4) -> Mesh: ...

    def multiply_vertex_colors(self, factor: scratchbox_native.math.Vec4) -> Mesh:
        """Multiply every vertex colour (COLOR_0) component-wise, keeping per-vertex variation such as AO"""

    def set_material(self, mat) -> Mesh: ...

    def apply_material(self, mat) -> Mesh: ...

    def compute_curvature_ao(self, intensity=0.65) -> Mesh: ...

    def apply_procedural_weathering(self, frequency: float = 2.0, amplitude: float = 0.15) -> Mesh: ...

    def displace_along_normals(self, frequency: float = 2.0, amplitude: float = 0.05) -> Mesh: ...

    def tessellate_and_displace(self, tessellation_factor: int = 4, displacement_scale: float = 0.06, noise_freq: float = 32.0, noise_amp: float = 0.015) -> Mesh: ...

    def clear(self) -> None: ...

    def recompute_normals(self) -> Mesh: ...

    def recompute_smooth_normals(self) -> Mesh: ...

    def weld_vertices(self, epsilon: float = 0.0001) -> Mesh: ...

    def recompute_bounds(self) -> Mesh: ...

    def subdivide(self, iterations: int = 1) -> Mesh: ...

    def taper(self, factor=0.5, axis=1) -> Mesh: ...

    def twist(self, angle_deg=45.0, axis=1) -> Mesh: ...

    def bend(self, angle_deg=30.0, radius=2.0, main_axis=1, bend_axis=0) -> Mesh: ...

    def bulge(self, *args, **kwargs) -> Mesh: ...

    def taubin_smooth(self, iterations=10, lambda_val=0.5, mu_val=-0.53, preserve_boundaries=True) -> Mesh: ...

    def clean(self, weld_epsilon=1e-05) -> Mesh: ...

    def bake_cavity_ao(self, intensity=0.65) -> Mesh: ...

    def slice_by_plane(self, plane_point=(0.0, 0.0, 0.0), plane_normal=(0.0, 1.0, 0.0), keep_positive=True, cap_cut=True) -> Mesh: ...

    def isotropic_remesh(self, target_edge_length=0.25, iterations=4, crease_angle_deg=45.0) -> Mesh: ...

    def decimate_qem(self, ratio=0.5, target_triangles=0, **kwargs) -> Mesh: ...

    def decimate(self, ratio=0.5, target_triangles=0, **kwargs) -> Mesh: ...

    def poisson_sample(self, count=100, min_distance=0.0, seed=42) -> list[scratchbox_native.processing.SurfaceSamplePoint]: ...

    def fill_holes(self, max_hole_edges=64) -> Mesh: ...

    def hausdorff_distance(self, other, samples=500) -> scratchbox_native.processing.HausdorffResult: ...

    def __repr__(self) -> str: ...

    def merge(self, other) -> Mesh: ...

    def tag(self, tag_name) -> Mesh: ...

    def get_tag(self) -> str: ...

    def align_to_terrain(self, terrain, offset_z=0.2) -> Mesh: ...

    def displace(self, frequency=2.0, amplitude=0.05, **kwargs) -> Mesh: ...

    def subtract(self, other) -> Mesh: ...

    def bake_curvature_ao(self, intensity=0.65) -> Mesh: ...

    def slice(self, plane_point=(0.0, 0.0, 0.0), plane_normal=(0.0, 1.0, 0.0), keep_positive=True, cap_cut=True) -> Mesh: ...

    def snap_to(self, target, face='top', clearance=0.0, offset=(0.0, 0.0, 0.0)) -> Mesh: ...

    def ground_on(self, target, clearance=0.0) -> Mesh: ...

    def __setattr__(self, name: str, value: typing.Any, /) -> None: ...

PbrMaterial = scratchbox.PbrMaterial

class Vertex:
    @typing.overload
    def __init__(self) -> None: ...

    @typing.overload
    def __init__(self, position: scratchbox_native.math.Vec3, normal: scratchbox_native.math.Vec3 = ..., uv: scratchbox_native.math.Vec2 = ..., color: scratchbox_native.math.Vec4 = ..., tangent: scratchbox_native.math.Vec4 = ...) -> None: ...

    @property
    def position(self) -> scratchbox_native.math.Vec3: ...
    @position.setter
    def position(self, value: scratchbox_native.math.Vec3) -> None: ...

    @property
    def normal(self) -> scratchbox_native.math.Vec3: ...
    @normal.setter
    def normal(self, value: scratchbox_native.math.Vec3) -> None: ...

    @property
    def uv(self) -> scratchbox_native.math.Vec2: ...
    @uv.setter
    def uv(self, value: scratchbox_native.math.Vec2) -> None: ...

    @property
    def color(self) -> scratchbox_native.math.Vec4: ...
    @color.setter
    def color(self, value: scratchbox_native.math.Vec4) -> None: ...

    @property
    def tangent(self) -> scratchbox_native.math.Vec4: ...
    @tangent.setter
    def tangent(self, value: scratchbox_native.math.Vec4) -> None: ...


