# Scratchbox IDE Environment Configuration Template
# Copy this file to .env and fill in your API keys and configuration.
# DO NOT commit your .env file to Git!

# Core Application & Session
SESSION_SECRET="your-session-secret-here"

# Google Maps & Geospatial APIs (Used for 3D Tiles, 2D Vector Roadmap, Street View)
GOOGLE_MAPS_API_KEY="AIzaSy..."
MAP_TILES_API_KEY="AIzaSy..."
GOOGLE_SEARCH_ENGINE_ID=""

# Google Cloud & Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=""
# Vertex AI region for chat and image models; leave empty for "global" (Gemini 3.x is not served on regional endpoints)
SCRATCHBOX_VERTEX_LOCATION=""
GOOGLE_CLOUD_API_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""
# Inline Service Account JSON (optional alternative to GOOGLE_APPLICATION_CREDENTIALS file)
# GOOGLE_SERVICE_ACCOUNT_JSON="{...}"

# Google Gemini & GenAI APIs
GEMINI_API_KEY=""
GOOGLE_AI_API_KEY=""
GOOGLE_GENAI_API_KEY=""

# Google OAuth Credentials
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# AI Model Providers (Optional / As Needed)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
FAL_KEY=""
REPLICATE_API_TOKEN=""
WORLDLABS_API_KEY=""
RUNWAY_API_KEY=""

# Database & Payments (Optional)
NEON_DATABASE_URL=""
NEON_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
